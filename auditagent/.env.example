# Copy to .env for local development. In production (Render), set these
# as real environment variables in the dashboard instead — see the
# "Deployment" section of README.md for the full walkthrough.

# Required for AI-generated recommendations (architect.py) and code
# review (code_reviewer.py). Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local dev: leave unset - falls back to a SQLite file automatically.
# Production: Render sets this automatically when you attach a Postgres
# instance via render.yaml (fromDatabase). Format:
#   postgresql://user:password@host:port/dbname
DATABASE_URL=

# Signs session cookies. Local dev: leave unset - auto-generated into
# .session_secret on first run. Production: MUST be set explicitly as a
# real env var (render.yaml generates one automatically) - the local-file
# fallback does NOT survive a Render redeploy (ephemeral filesystem),
# which would silently log every user out and invalidate every session
# on every single deploy.
SESSION_SECRET_KEY=

# Encrypts each user's target-site credentials at rest. Local dev: leave
# unset - auto-generated into .credentials_master.key on first run.
# Production: MUST be set explicitly to a REAL Fernet key - generate one
# with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A platform's generic "auto-generate a secret" feature will NOT work
# here (confirmed by testing directly) - Fernet requires an exact format,
# and a generic random string fails with a clear error on startup rather
# than silently corrupting anything. Same ephemeral-filesystem risk as
# SESSION_SECRET_KEY if left to the local-file fallback in production:
# every redeploy would make all previously-stored credentials permanently
# undecryptable.
CREDENTIALS_MASTER_KEY=

# The real deployed Vercel frontend URL, once you have one - added to
# the CORS allowed-origins list alongside localhost. Without this,
# cookie-based login will fail from the real frontend with a CORS error,
# since localhost is not automatically included once deployed.
FRONTEND_URL=
